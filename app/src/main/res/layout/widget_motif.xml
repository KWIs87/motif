<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4x2 (board Widget): card, art, title, artist, previous / play-pause / next. Nothing else.
     Sized to fit 180x90 dp (Samsung's smaller grid cells): the provider hides the art and the artist
     line below about 110 dp of height and previous/next below about 150 dp of width. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_text_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/widget_art_bg"
                android:scaleType="centerCrop"
                android:contentDescription="Widget settings" />

            <LinearLayout
                android:id="@+id/widget_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#E8E6E1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:text="Motif" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:alpha="0.6"
                    android:textColor="#E8E6E1"
                    android:textSize="12sp"
                    android:text="Nothing playing" />
            </LinearLayout>
        </LinearLayout>

        <!-- Three equal cells so the buttons spread with the width and still fit at 180 dp. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_prev_cell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:contentDescription="Previous"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/widget_play_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageButton
                        android:id="@+id/widget_play"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Play or pause"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_next_cell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:contentDescription="Next"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
